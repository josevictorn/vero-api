// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["vero"]
}

enum Role {
  ADMIN
  LAWYER
  ASSISTANT

  @@schema("vero")
}

enum LeadStatus {
  NEW_LEAD
  INTERVIEWING
  FORWARDED
  COMPLETED

  @@schema("vero")
}

enum AiSessionStatus {
  IDENTIFYING
  INTERVIEWING
  FORWARDED
  BOOKING
  BOOKED

  @@schema("vero")
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(ASSISTANT)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  googleCalendarConnection GoogleCalendarConnection?
  calendarEvents           CalendarEvent[]
  lawyer                   Lawyer?
  passwordResetToken       PasswordResetToken[]

  @@map("users")
  @@schema("vero")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  email     String
  cellphone String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lawyers Lawyer[]
  leads   Lead[]
  clients Client[]

  @@map("workspaces")
  @@schema("vero")
}

model Lawyer {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  workspaceId String   @map("workspace_id")
  cellphone   String
  name        String
  oab         String
  oabState    String   @map("oab_state")
  pix         String   @map("pix_advogado")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  leads   Lead[]
  clients Client[]

  @@map("lawyers")
  @@schema("vero")
}

model Lead {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  lawyerId    String?  @map("lawyer_id")
  name        String
  cellphone   String
  email       String?
  status      LeadStatus @default(NEW_LEAD) @map("lead_status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lawyer    Lawyer?   @relation(fields: [lawyerId], references: [id])

  caseAnalyses CaseAnalysis[]
  client       Client? @relation("LeadToClient")

  @@map("leads")
  @@schema("vero")
  @@index([workspaceId])
  @@index([lawyerId])
}

model Client {
  id        String @id @default(uuid())
  name      String
  maritalStatus String @map("marital_status")
  profession String
  rg        String
  issuingAgency String @map("issuing_agency")
  cpf       String
  street    String
  neighborhood String
  city      String
  state     String
  zipCode   String @map("zip_code")
  email     String
  cellphone String
  

  workspaceId       String  @map("workspace_id")
  lawyerId          String? @map("lawyer_id")
  createdFromLeadId String? @unique

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lawyer    Lawyer?   @relation(fields: [lawyerId], references: [id])
  lead      Lead?     @relation("LeadToClient", fields: [createdFromLeadId], references: [id])

  @@map("clients")
  @@index([workspaceId])
  @@index([lawyerId])
  @@schema("vero")
}

model ScreeningFlow {
  id        String   @id @default(uuid())
  caseType  String   @map("case_type")
  lawyerId  String?  @map("lawyer_id")
  questions Json
  createdAt DateTime @default(now()) @map("created_at")

  aiSessions AiSession[]

  @@map("screening_flows")
  @@schema("vero")
}

model GoogleCalendarConnection {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  googleEmail     String   @map("google_email")
  accessToken     String   @map("access_token")
  refreshToken    String   @map("refresh_token")
  tokenExpiresAt  DateTime @map("token_expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_calendar_connections")
  @@schema("vero")
}

model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  googleEventId String   @map("google_event_id")
  summary       String
  description   String?
  startsAt      DateTime @map("starts_at")
  endsAt        DateTime @map("ends_at")
  hangoutLink   String?  @map("hangout_link")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, googleEventId])
  @@index([userId])
  @@map("calendar_events")
  @@schema("vero")
}

model AiSession {
  id              String   @id @default(uuid())
  screeningFlowId String?  @map("screening_flow_id")
  leadId          String?  @map("lead_id")
  chatId          String   @map("chat_id")
  status          AiSessionStatus @default(IDENTIFYING)
  chatState       Json     @map("chat_state")
  name            String
  cellphone       String
  isThirdParty    Boolean  @default(false) @map("is_third_party")
  createdAt       DateTime @default(now()) @map("created_at")

  screeningFlow ScreeningFlow? @relation(fields: [screeningFlowId], references: [id], onDelete: Cascade)
  caseAnalyses  CaseAnalysis[]

  @@map("ai_sessions")
  @@schema("vero")
}

model CaseAnalysis {
  id                  String   @id @default(uuid())
  aiSessionId         String   @map("ai_session_id")
  leadId              String   @map("lead_id")
  title               String
  viabilityLabel      String   @map("viability_label")
  analysisText        String   @map("analysis_text")
  estimatedComplexity String   @map("estimated_complexity")
  mainLegalBase       String   @map("main_legal_base")
  createdAt           DateTime @default(now()) @map("created_at")

  aiSession AiSession @relation(fields: [aiSessionId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("case_analyses")
  @@schema("vero")
}

model PasswordResetToken {
  id        String      @id @default(uuid())
  userId    String      @map("user_id")
  token     String      @unique
  expiresAt DateTime    @map("expires_at")
  usedAt    DateTime?   @map("used_at")
  createdAt DateTime    @default(now()) @map("created_at")

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_token")
  @@schema("vero")
}
