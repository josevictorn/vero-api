// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  LAWYER
  ASSISTANT
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(ASSISTANT)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leads Lead[] @relation("LawyerLeads")

  @@map("users")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  cnpj      String   @unique
  email     String
  cellphone String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  leads Lead[]

  @@map("workspaces")
}

model Lead {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  lawyerId    String?  @map("lawyer_id")
  name        String
  cellphone   String
  email       String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lawyer    User?     @relation("LawyerLeads", fields: [lawyerId], references: [id])

  @@map("leads")
}

model ScreeningFlow {
  id        String   @id @default(uuid())
  caseType  String   @map("case_type")
  questions Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("screening_flows")
}